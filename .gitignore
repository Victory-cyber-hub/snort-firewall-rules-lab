# Operating system
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Logs / temporary files
*.log
*.tmp
*.swp

# Credentials / secrets
.env
.env.*
*.pem
*.key
*.crt

# Potentially unsafe lab binaries
*.exe
*.bin

# Packet captures - keep local unless intentionally sanitized
*.pcap
*.pcapng

# Keep repository folders
!screenshots/**/.gitkeep
!evidence/**/.gitkeep
